{#
    Class Central sponsored course recommendations.

    Two public macros for vertical ads in the sidebar and bottom banner ads:

      classCentralCourseAd(ccData)     - narrow vertical rail, top of the sidebar
      classCentralCourseBanner(ccData) - wide horizontal band, above the bottom
                                         ad slot
#}

{# Advertisement / source disclosure row #}
{% macro _disclosure() %}
    {% set adLabel %}{% t 'ad-text' %}{% endset %}
    <div class="partner-courses-disclosure">
        <span class="partner-courses-disclosure-label">{{ adLabel | upper }}</span>
        <span class="partner-courses-disclosure-source">Class Central</span>
    </div>
{% endmacro %}

{# Single course card for both layouts #}
{% macro _courseCard(course) %}
    <a
        class="partner-courses-course"
        href="{{ course.url.go }}"
        rel="sponsored noopener noreferrer"
        target="_blank"
    >
        {% if course.imageUrl %}
            <span class="partner-courses-thumbnail">
                <img src="{{ course.imageUrl }}" alt="" loading="lazy">
            </span>
        {% endif %}
        <span class="partner-courses-provider">On {{ course.provider.name }}</span>
        <span class="partner-courses-title">{{ course.name }}</span>
        {% if course.instructorName %}
            <span class="partner-courses-instructor">{{ course.instructorName }}</span>
        {% endif %}
        <span class="partner-courses-stats">
            {% if course.rating.provider.average %}
                <span class="partner-courses-stat partner-courses-rating">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.4 6.9.7-5.2 4.7 1.5 6.8L12 17.6l-6.1 3.5 1.5-6.8-5.2-4.7 6.9-.7z"/></svg>
                    {{ course.rating.provider.average | round(1) }}<span class="sr-only"> out of 5 stars</span>
                    {%- if course.ratingCount %} <span class="partner-courses-rating-count" aria-hidden="true">({{ course.ratingCount }})</span><span class="sr-only"> from {{ course.ratingCount }} ratings</span>{% endif %}
                </span>
            {% endif %}
            {% if course.effortShort %}
                <span class="partner-courses-stat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3" stroke-linecap="round"/></svg>
                    <span aria-hidden="true">{{ course.effortShort }}</span>
                    <span class="sr-only">{{ course.effort }}</span>
                </span>
            {% endif %}
            {% if course.level %}
                <span class="partner-courses-stat">{{ course.level | capitalize }}</span>
            {% endif %}
            {% if course.certificate %}
                <span class="partner-courses-stat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="5"/><path d="M8.5 12.5 7 21l5-2.5L17 21l-1.5-8.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Certificate
                </span>
            {% endif %}
        </span>
        <span class="partner-courses-cta">
            View course
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
        </span>
        <span class="sr-only">(opens in a new tab)</span>
    </a>
{% endmacro %}

{# Up to four course cards in a list and footer link #}
{% macro _courseList(ccData) %}
    {% set topSubject = ccData.subjects[0] %}
    <ul class="partner-courses-list" role="list">
        {% for course in ccData.courses %}
            {% if loop.index0 < 4 %}
                <li>{{ _courseCard(course) }}</li>
            {% endif %}
        {% endfor %}
    </ul>
    {% if topSubject %}
        <a
            class="partner-courses-more"
            href="{{ topSubject.url }}"
            rel="sponsored noopener noreferrer"
            target="_blank"
        ><span>More {{ topSubject.name }} courses on Class Central <span aria-hidden="true">&rarr;</span></span><span class="sr-only">(opens in a new tab)</span></a>
    {% endif %}
{% endmacro %}

{# Outer container for both vertical and horizontal banner ad types #}
{% macro _shell(ccData, variant) %}
    <section
        class="partner-courses partner-courses-{{ variant }}"
        aria-labelledby="partner-courses-label-{{ variant }}"
        data-test-label="class-central-course-{{ variant }}"
    >
        <p class="partner-courses-label" id="partner-courses-label-{{ variant }}">Recommended courses from our partners</p>
        <div class="partner-courses-card">
            {{ _disclosure() }}
            {{ _courseList(ccData) }}
        </div>
    </section>
{% endmacro %}

{% macro classCentralCourseAd(ccData) %}{{ _shell(ccData, "rail") }}{% endmacro %}
{% macro classCentralCourseBanner(ccData) %}{{ _shell(ccData, "banner") }}{% endmacro %}
